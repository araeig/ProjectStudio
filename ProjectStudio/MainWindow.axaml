<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ProjectStudio.MainWindow"
        Title="Project Studio"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen">

	<Window.Styles>
		<Style Selector="Border.card">
			<Setter Property="BorderBrush" Value="#30808080" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="16" />
		</Style>
		<Style Selector="Button.menu">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Padding" Value="12,8" />
		</Style>
	</Window.Styles>

	<Panel>
		<Border x:Name="LoginPanel" Classes="card" Width="360" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
			<StackPanel Spacing="12">
				<TextBlock Text="Project Studio" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
				<TextBlock Text="Вход в систему" Foreground="Gray" HorizontalAlignment="Center" />
				<TextBox x:Name="LoginBox" Watermark="Логин" />
				<TextBox x:Name="PasswordInput" Watermark="Пароль" PasswordChar="*" />
				<TextBlock x:Name="ErrorText" Foreground="Red" />
				<Button Content="Войти" Click="Login_Click" IsDefault="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#6A55E6" Foreground="White" />
				<TextBlock Text="Логин: admin, пароль: 123" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" />
			</StackPanel>
		</Border>

		<Grid x:Name="MainPanel" ColumnDefinitions="220,*" IsVisible="False">
			<Border BorderBrush="#30808080" BorderThickness="0,0,1,0" Padding="10">
				<DockPanel>
					<StackPanel DockPanel.Dock="Bottom" Spacing="4">
						<Button x:Name="ProfileButton" Classes="menu" Click="Profile_Click" />
						<Button Classes="menu" Content="Выйти" Click="Logout_Click" />
					</StackPanel>
					<StackPanel Spacing="4">
						<TextBlock Text="Project Studio" FontSize="16" FontWeight="Bold" Margin="12,6,0,16" />
						<Button x:Name="OverviewButton" Classes="menu" Content="Обзор" Click="Overview_Click" />
						<Button x:Name="ProjectsButton" Classes="menu" Content="Проекты" Click="Projects_Click" />
						<Button x:Name="TasksButton" Classes="menu" Content="Задачи" Click="Tasks_Click" />
						<Button x:Name="CalendarButton" Classes="menu" Content="Календарь" Click="Calendar_Click" />
						<Button x:Name="TeamButton" Classes="menu" Content="Команда" Click="Team_Click" />
						<Button x:Name="SettingsButton" Classes="menu" Content="Настройки" Click="Settings_Click" />
					</StackPanel>
				</DockPanel>
			</Border>

			<ScrollViewer Grid.Column="1">
				<Panel Margin="24">

					<StackPanel x:Name="OverviewPage" Spacing="16">
						<TextBlock Text="Обзор" FontSize="22" FontWeight="Bold" />
						<Grid ColumnDefinitions="*,*,*,*">
							<Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
								<StackPanel>
									<TextBlock Text="Проекты" Foreground="Gray" />
									<TextBlock Text="12" FontSize="28" FontWeight="Bold" />
									<TextBlock Text="Активных проектов" Foreground="Gray" FontSize="12" />
								</StackPanel>
							</Border>
							<Border Grid.Column="1" Classes="card" Margin="0,0,10,0">
								<StackPanel>
									<TextBlock Text="Задачи" Foreground="Gray" />
									<TextBlock Text="48" FontSize="28" FontWeight="Bold" />
									<TextBlock Text="В работе" Foreground="Gray" FontSize="12" />
								</StackPanel>
							</Border>
							<Border Grid.Column="2" Classes="card" Margin="0,0,10,0">
								<StackPanel>
									<TextBlock Text="Команда" Foreground="Gray" />
									<TextBlock Text="8" FontSize="28" FontWeight="Bold" />
									<TextBlock Text="Участников" Foreground="Gray" FontSize="12" />
								</StackPanel>
							</Border>
							<Border Grid.Column="3" Classes="card">
								<StackPanel>
									<TextBlock Text="Сроки" Foreground="Gray" />
									<TextBlock Text="5" FontSize="28" FontWeight="Bold" Foreground="#E5484D" />
									<TextBlock Text="Просрочено" Foreground="#E5484D" FontSize="12" />
								</StackPanel>
							</Border>
						</Grid>

						<Grid ColumnDefinitions="*,340">
							<StackPanel Spacing="16" Margin="0,0,16,0">
								<Border Classes="card">
									<StackPanel Spacing="14">
										<TextBlock Text="Активные проекты" FontWeight="Bold" />
										<Grid ColumnDefinitions="*,200,50">
											<TextBlock Text="Avalonia UI Redesign" FontWeight="SemiBold" />
											<StackPanel Grid.Column="1" Spacing="6">
												<Border Background="#336A55E6" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
													<TextBlock Text="Дизайн" FontSize="11" Foreground="#6A55E6" />
												</Border>
												<ProgressBar Value="65" Foreground="#6A55E6" />
											</StackPanel>
											<TextBlock Grid.Column="2" Text="65%" Foreground="Gray" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
										</Grid>
										<Grid ColumnDefinitions="*,200,50">
											<TextBlock Text="Мобильное приложение" FontWeight="SemiBold" />
											<StackPanel Grid.Column="1" Spacing="6">
												<Border Background="#334C82F7" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
													<TextBlock Text="Разработка" FontSize="11" Foreground="#4C82F7" />
												</Border>
												<ProgressBar Value="40" Foreground="#4C82F7" />
											</StackPanel>
											<TextBlock Grid.Column="2" Text="40%" Foreground="Gray" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
										</Grid>
										<Grid ColumnDefinitions="*,200,50">
											<TextBlock Text="Корпоративный сайт" FontWeight="SemiBold" />
											<StackPanel Grid.Column="1" Spacing="6">
												<Border Background="#334C82F7" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
													<TextBlock Text="Разработка" FontSize="11" Foreground="#4C82F7" />
												</Border>
												<ProgressBar Value="80" Foreground="#30A46C" />
											</StackPanel>
											<TextBlock Grid.Column="2" Text="80%" Foreground="Gray" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
										</Grid>
									</StackPanel>
								</Border>

								<Border Classes="card">
									<StackPanel Spacing="6">
										<TextBlock Text="Последние задачи" FontWeight="Bold" />
										<Grid ColumnDefinitions="*,100,90">
											<CheckBox Content="Разработать макет главной страницы" />
											<TextBlock Grid.Column="1" Text="Дизайн" Foreground="#6A55E6" VerticalAlignment="Center" />
											<TextBlock Grid.Column="2" Text="15.05.2024" Foreground="Gray" VerticalAlignment="Center" />
										</Grid>
										<Grid ColumnDefinitions="*,100,90">
											<CheckBox Content="Реализовать авторизацию" />
											<TextBlock Grid.Column="1" Text="Разработка" Foreground="#4C82F7" VerticalAlignment="Center" />
											<TextBlock Grid.Column="2" Text="14.05.2024" Foreground="Gray" VerticalAlignment="Center" />
										</Grid>
										<Grid ColumnDefinitions="*,100,90">
											<CheckBox Content="Подготовить презентацию" />
											<TextBlock Grid.Column="1" Text="Маркетинг" Foreground="#30A46C" VerticalAlignment="Center" />
											<TextBlock Grid.Column="2" Text="13.05.2024" Foreground="Gray" VerticalAlignment="Center" />
										</Grid>
									</StackPanel>
								</Border>
							</StackPanel>

							<Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
								<StackPanel Spacing="8">
									<TextBlock Text="Календарь" FontWeight="Bold" />
									<Calendar HorizontalAlignment="Center" />
								</StackPanel>
							</Border>
						</Grid>
					</StackPanel>

					<StackPanel x:Name="ProjectsPage" Spacing="16" IsVisible="False">
						<TextBlock Text="Проекты" FontSize="22" FontWeight="Bold" />
						<Border Classes="card">
							<StackPanel Spacing="6">
								<TextBlock Text="Avalonia UI Redesign" FontSize="16" FontWeight="SemiBold" />
								<TextBlock Text="Обновление интерфейса приложения" Foreground="Gray" />
								<ProgressBar Value="65" Foreground="#6A55E6" />
								<TextBlock Text="Прогресс: 65% · Дедлайн: 30.05.2024" Foreground="Gray" FontSize="12" />
							</StackPanel>
						</Border>
						<Border Classes="card">
							<StackPanel Spacing="6">
								<TextBlock Text="Мобильное приложение" FontSize="16" FontWeight="SemiBold" />
								<TextBlock Text="Клиент для iOS и Android" Foreground="Gray" />
								<ProgressBar Value="40" Foreground="#4C82F7" />
								<TextBlock Text="Прогресс: 40% · Дедлайн: 15.06.2024" Foreground="Gray" FontSize="12" />
							</StackPanel>
						</Border>
						<Border Classes="card">
							<StackPanel Spacing="6">
								<TextBlock Text="Корпоративный сайт" FontSize="16" FontWeight="SemiBold" />
								<TextBlock Text="Лендинг и личный кабинет" Foreground="Gray" />
								<ProgressBar Value="80" Foreground="#30A46C" />
								<TextBlock Text="Прогресс: 80% · Дедлайн: 20.05.2024" Foreground="Gray" FontSize="12" />
							</StackPanel>
						</Border>
					</StackPanel>

					<StackPanel x:Name="TasksPage" Spacing="16" IsVisible="False">
						<TextBlock Text="Задачи" FontSize="22" FontWeight="Bold" />
						<Grid ColumnDefinitions="*,Auto">
							<TextBox x:Name="NewTaskBox" Watermark="Новая задача" Margin="0,0,10,0" />
							<Button Grid.Column="1" Content="Добавить" Click="AddTask_Click" Background="#6A55E6" Foreground="White" />
						</Grid>
						<Border Classes="card">
							<StackPanel x:Name="TasksList" Spacing="6">
								<CheckBox Content="Разработать макет главной страницы" />
								<CheckBox Content="Реализовать авторизацию" />
								<CheckBox Content="Подготовить презентацию" />
								<CheckBox Content="Настроить базу данных" />
								<CheckBox Content="Протестировать приложение" />
							</StackPanel>
						</Border>
					</StackPanel>

					<StackPanel x:Name="CalendarPage" Spacing="16" IsVisible="False">
						<TextBlock Text="Календарь" FontSize="22" FontWeight="Bold" />
						<Border Classes="card" HorizontalAlignment="Left">
							<Calendar />
						</Border>
					</StackPanel>

					<StackPanel x:Name="TeamPage" Spacing="16" IsVisible="False">
						<TextBlock Text="Команда" FontSize="22" FontWeight="Bold" />
						<WrapPanel>
							<Border Classes="card" Width="220" Margin="0,0,12,12">
								<StackPanel>
									<TextBlock Text="Петров Иван" FontWeight="SemiBold" />
									<TextBlock Text="UI/UX дизайнер" Foreground="Gray" />
								</StackPanel>
							</Border>
							<Border Classes="card" Width="220" Margin="0,0,12,12">
								<StackPanel>
									<TextBlock Text="Смирнова Ольга" FontWeight="SemiBold" />
									<TextBlock Text="Frontend-разработчик" Foreground="Gray" />
								</StackPanel>
							</Border>
							<Border Classes="card" Width="220" Margin="0,0,12,12">
								<StackPanel>
									<TextBlock Text="Кузнецов Дмитрий" FontWeight="SemiBold" />
									<TextBlock Text="Backend-разработчик" Foreground="Gray" />
								</StackPanel>
							</Border>
							<Border Classes="card" Width="220" Margin="0,0,12,12">
								<StackPanel>
									<TextBlock Text="Соколова Мария" FontWeight="SemiBold" />
									<TextBlock Text="Маркетолог" Foreground="Gray" />
								</StackPanel>
							</Border>
							<Border Classes="card" Width="220" Margin="0,0,12,12">
								<StackPanel>
									<TextBlock Text="Морозова Екатерина" FontWeight="SemiBold" />
									<TextBlock Text="Тестировщик" Foreground="Gray" />
								</StackPanel>
							</Border>
						</WrapPanel>
					</StackPanel>

					<StackPanel x:Name="SettingsPage" Spacing="16" IsVisible="False">
						<TextBlock Text="Настройки" FontSize="22" FontWeight="Bold" />
						<Border Classes="card">
							<Grid ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Тёмная тема" FontWeight="SemiBold" />
									<TextBlock Text="Переключение светлой и тёмной темы" Foreground="Gray" />
								</StackPanel>
								<ToggleSwitch x:Name="ThemeSwitch" Grid.Column="1" Click="Theme_Click" OnContent="" OffContent="" />
							</Grid>
						</Border>
					</StackPanel>

					<StackPanel x:Name="ProfilePage" Spacing="16" IsVisible="False">
						<TextBlock Text="Личный кабинет" FontSize="22" FontWeight="Bold" />
						<Border Classes="card" Width="400" HorizontalAlignment="Left">
							<StackPanel Spacing="10">
								<TextBlock x:Name="ProfileName" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
								<TextBlock Text="Должность: Руководитель проектов" Foreground="Gray" />
								<TextBlock Text="Логин: admin" Foreground="Gray" />
								<Button Content="Выйти из аккаунта" Click="Logout_Click" Background="#6A55E6" Foreground="White" />
							</StackPanel>
						</Border>
					</StackPanel>

				</Panel>
			</ScrollViewer>
		</Grid>
	</Panel>
</Window>